PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# Authorize.Net Credentials
AUTHORIZENET_API_LOGIN_ID=your_login_id
AUTHORIZENET_TRANSACTION_KEY=your_transaction_key
AUTHORIZENET_ENVIRONMENT=SANDBOX

# Company Branding
